# Google OAuth (client ID is public, required for frontend + backend)
VITE_GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_ID=your_google_client_id

# SendGrid for order notifications
# Create API key at https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=your_sendgrid_api_key
ADMIN_NOTIFY_EMAIL=admin@example.com

# JWT secret for signing auth tokens
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-to-a-random-secret

# CORS origin (frontend URL, defaults to http://localhost:3000 in dev)
CORS_ORIGIN=http://localhost:3000

# Rate limit overrides (optional — defaults: auth=10, api=100, upload=20 per 15min)
# AUTH_RATE_MAX=10
# API_RATE_MAX=100
# UPLOAD_RATE_MAX=20
# RATE_LIMIT_WINDOW_MS=900000
