# ─── Supabase ────────────────────────────────────────────────────────────────
# Project Settings > API in the Supabase dashboard.
# URL + anon key are public (they ship in the frontend bundle).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key

# Used only by local scripts (one-time data migration, verification, tests).
# NEVER put the service role key in a Vercel/frontend environment variable.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ─── Transactional email ─────────────────────────────────────────────────────
# Stored as Supabase Edge Function secrets, not in the frontend:
#   supabase secrets set SENDGRID_API_KEY=... ADMIN_NOTIFY_EMAIL=... SENDGRID_FROM_EMAIL=...
# Create the API key at https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=
ADMIN_NOTIFY_EMAIL=admin@example.com
SENDGRID_FROM_EMAIL=admin@example.com

# ─── Google OAuth (paused) ───────────────────────────────────────────────────
# Re-enable later under Supabase Dashboard > Authentication > Providers > Google.
# No client secret belongs in this file, and the UI is hidden while paused.
GOOGLE_CLIENT_ID=
